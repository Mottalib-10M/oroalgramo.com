---
/** Pages à insérer (iframe) : un calculateur seul, en espagnol et en anglais. noindex, hors sitemap (astro.config). */
import '../../../styles/global.css';
import Tool from '../../../components/calc/Tool';
import { SITE_URL, SITE_NAMES, LANG_TAGS } from '../../../data/site-config';
import { route } from '../../../i18n/routes';
const EMBEDS = {
  'precio-oro-gramo': { tool: 'board', page: 'home', t: { es: 'Precio del oro hoy por gramo y ley', en: 'Gold price per gram by fineness in Spain' } },
  'comprobar-oferta': { tool: 'offer', page: 'offer', t: { es: 'Comprueba la oferta de un compro oro', en: 'Check a gold buyer’s offer' } },
} as const;
export function getStaticPaths() {
  return (['es', 'en'] as const).flatMap((lang) => ['precio-oro-gramo', 'comprobar-oferta'].map((name) => ({ params: { lang, name } })));
}
const { lang, name } = Astro.params as { lang: 'es' | 'en'; name: keyof typeof EMBEDS };
const e = EMBEDS[name];
const page = `${SITE_URL}${route(e.page, lang)}`;
const note = { es: 'Sitio independiente · nada de lo que escribes sale de tu equipo · calculadora de Radif Partners', en: 'Independent site · nothing you type leaves your device · calculator by Radif Partners' }[lang];
---
<!doctype html>
<html lang={LANG_TAGS[lang]}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{`${e.t[lang]} (${lang === 'es' ? 'para insertar' : 'embed'})`}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={page} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <main><Tool client:load tool={e.tool} lang={lang} idp="embed" mini /></main>
    <p class="mt-2 text-center text-xs text-navy-600"><a href={page} target="_blank" rel="noopener" class="underline">{SITE_NAMES[lang]}</a> · {note}</p>
  </body>
</html>
