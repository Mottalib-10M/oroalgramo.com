---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { route } from '../../i18n/routes';
import { AUTHOR_NAME, AUTHOR_DESC, CONTACT_EMAIL, SITE_NAMES } from '../../data/site-config';
import { srcLink } from '../../lib/helpers';
import { profilePageSchema, organizationSchema, breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const path = route('about', lang);
const title = 'Independent publisher of Oro al Gramo and its sources';
const description = 'Oro al Gramo is published by Radif Partners: free calculators of the value of gold and silver by fineness in Spain, with no gold buyer behind them, no account.';
const s = (k: string, t: string) => srcLink(k, lang, t);
---
<PageLayout title={title} description={description} lang={lang} jsonLd={[organizationSchema(lang), profilePageSchema({ path, lang }), breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'About', path }])]} breadcrumbs={[{ label: 'About' }]}>
  <article class="prose prose-slate max-w-none">
    <h1>About this site</h1>
    <p>{AUTHOR_DESC.en}</p>
    <h2>Why {SITE_NAMES[lang]} exists</h2>
    <p>Anyone in Spain looking up what their gold is worth mostly finds international templates run through a translator, with prices that disagree from one table to the next and nothing about Spanish hallmarks, or shops that only quote in store. Here the metal price carries its time, every fineness is one Spanish law allows, and a buyer's offer becomes the share of the metal it really pays.</p>
    <h2>Who publishes it</h2>
    <p>{AUTHOR_NAME}, a company that builds tools from public laws and data. It is not a gold buyer, a jeweller, a bank or a tax adviser. It charges nothing, has no affiliate links and recommends no shop.</p>
    <LegalIdentity lang={lang} />
    <h2>Where the figures come from</h2>
    <p>Gold and silver finenesses from <Fragment set:html={s('ley17', 'Law 17/1985')} />; income tax from <Fragment set:html={s('lirpf', 'Act 35/2006')} />; transfer tax from the <Fragment set:html={s('itp', '1993 consolidated act')} />; VAT on investment gold from <Fragment set:html={s('liva', 'Act 37/1992')} />; the cash payment limit from <Fragment set:html={s('l7_2012', 'Law 7/2012')} />. The metal price from <Fragment set:html={s('goldApi', 'gold-api.com')} />. How we work things out is on the <a href={route('method', lang)}>method</a> page; how we correct, in the <a href={route('editorial', lang)}>editorial policy</a>.</p>
    <h2>Your data</h2>
    <p>The calculators run only in your browser: no account, no form, no storage. More in the <a href={route('privacy', lang)}>privacy policy</a>.</p>
    <h2>Write to us</h2>
    <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>, if you spot a misread figure or a law that has changed.</p>
  </article>
</PageLayout>
