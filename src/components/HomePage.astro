---
/**
 * Accueil (pilier) : titre, une ligne, prix du gramme par ley (simulateur, premier écran), bloc citable
 * replié, puis le corps (leyes, oferta, plata, impuestos), FAQ.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Tool from './calc/Tool';
import Clamp from './Clamp.astro';
import { HOME } from '../content/home';
import { helpers, fill } from '../lib/helpers';
import { replierSections } from '../lib/replis';
import { route, type Locale } from '../i18n/routes';
import { navCategories } from '../i18n/nav';
import { t } from '../i18n/ui';
import { P } from '../lib/engine/params';
import { organizationSchema, websiteSchema, webApplicationSchema, faqSchema, webPageSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const H = HOME[lang];
const x = { title: fill(H.title, lang), description: fill(H.description, lang), h1: fill(H.h1, lang), lead: fill(H.lead, lang), resume: fill(H.resume, lang), faqs: H.faqs.map((f) => ({ q: fill(f.q, lang), a: fill(f.a, lang), open: f.open })) };
const body = replierSections(fill(H.body(helpers(lang)), lang), 0, lang === 'es' ? 'Más sobre leyes, ofertas, plata e impuestos: toca un título para abrirlo.' : 'More on finenesses, offers, silver and tax: tap a heading to open it.');
const parts = body.split(/<!--tool:([a-z]+)-->/);
const path = route('home', lang);
const ui = t(lang);
const jsonLd = [organizationSchema(lang), websiteSchema(lang), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), webPageSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const sources = ['goldApi', 'ley17', 'lirpf', 'itp', 'liva', 'l7_2012', 'nistB9'].map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const cats = navCategories(lang, false);
const start = lang === 'es'
  ? [[route('offer', lang), 'Tengo una oferta que comprobar'], [route('lote', lang), 'Varias piezas de leyes distintas'], [route('irpf', lang), 'Impuestos al vender'], [route('plata', lang), 'Plata de ley 925']]
  : [[route('offer', lang), 'I have an offer to check'], [route('lote', lang), 'Several pieces, mixed fineness'], [route('irpf', lang), 'Tax when I sell'], [route('plata', lang), '925 sterling silver']];
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <h1 class="mb-1 text-[1.6rem] font-bold leading-tight text-navy-900 sm:text-3xl">{x.h1}</h1>
  <p class="mb-3 text-navy-700">{x.lead}</p>
  <nav aria-label={lang === 'es' ? 'Empieza por tu caso' : 'Start from your situation'} class="mb-3 grid grid-cols-2 gap-2 text-sm font-medium" data-chrome>
    {start.map(([h, l]) => <a href={h} class="flex min-h-[44px] items-center rounded-lg border border-accent-300 bg-accent-50 px-3 py-1.5 leading-snug text-navy-900 hover:border-accent-500">{l} →</a>)}
  </nav>
  <div class="mb-8" data-outil><Tool client:load tool="board" lang={lang} idp="b" ley={750} grams={10} /></div>
  <Clamp text={x.resume} lang={lang} id="clamp-home" label={ui.readMore} class="mb-8" />
  <div class="prose prose-slate max-w-none">
    {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <div id={p} class="not-prose my-6 scroll-mt-20" data-chrome><Tool client:load tool={p} lang={lang} idp={`h${i}`} mini /></div>)}
  </div>
  <details class="pli" style="margin-top:0;border-top:0" data-chrome>
    <summary><h2 class="text-2xl font-bold text-navy-900">{lang === 'es' ? 'Todas las calculadoras y guías' : 'All calculators and guides'}</h2></summary>
    <div class="mt-3 grid gap-6 sm:grid-cols-3">
      {cats.map((c) => (<div><h3 class="mb-2 font-semibold text-navy-900">{c.label}</h3><ul class="space-y-1 text-sm">{c.links.map((l) => <li><a href={l.href} class="text-accent-700 hover:underline">{l.label}</a></li>)}</ul></div>))}
    </div>
  </details>
</PageLayout>
